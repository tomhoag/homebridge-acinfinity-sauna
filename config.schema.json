{
  "pluginAlias": "ACInfinitySauna",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Adds an **End Sauna** switch, which stops the HUUM heater and runs the AC Infinity fan in Auto until the sauna cools before setting it Off, and a **Sauna Fan** switch that shows whether the fan is running and turns it On or Off. Supports the UIS Controller 69 Pro and 69 Pro+.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "AC Infinity Sauna"
      },
      "acinfinity": {
        "title": "AC Infinity",
        "type": "object",
        "required": ["email", "password", "port"],
        "properties": {
          "email": { "title": "Email", "type": "string", "format": "email" },
          "password": {
            "title": "Password",
            "type": "string",
            "description": "Only the first 25 characters are used; the AC Infinity API ignores the rest."
          },
          "controllerId": {
            "title": "Controller devId",
            "type": "string",
            "description": "Leave blank if the account has one 69 Pro or Pro+. Otherwise the log lists each controller's devId."
          },
          "port": {
            "title": "Fan port",
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        }
      },
      "cooldown": {
        "title": "Cooldown",
        "type": "object",
        "properties": {
          "temperatureF": {
            "title": "Target temperature (°F)",
            "type": "number",
            "default": 90,
            "minimum": 32,
            "maximum": 200,
            "description": "The fan runs until the probe reads at or below this temperature."
          },
          "fanSpeed": {
            "title": "Fan speed",
            "type": "integer",
            "default": 10,
            "minimum": 1,
            "maximum": 10
          },
          "checkIntervalMinutes": {
            "title": "Check interval (minutes)",
            "type": "number",
            "default": 10,
            "minimum": 1
          }
        }
      },
      "scheduledOffTime": {
        "title": "Daily Off time (HH:MM)",
        "type": "string",
        "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
        "description": "Optional backstop: sets the fan port Off at this local time every day. Leave blank to disable."
      },
      "huum": {
        "title": "HUUM",
        "type": "object",
        "properties": {
          "email": { "title": "Email", "type": "string", "format": "email" },
          "password": { "title": "Password", "type": "string" }
        }
      },
      "endSaunaName": {
        "title": "End Sauna switch name",
        "type": "string",
        "default": "End Sauna"
      },
      "fanName": {
        "title": "Fan switch name",
        "type": "string",
        "default": "Sauna Fan"
      },
      "debug": {
        "title": "Debug logging",
        "type": "boolean",
        "default": false,
        "description": "Log API request and response bodies. Passwords and tokens are never logged."
      }
    }
  },
  "layout": [
    "name",
    {
      "type": "fieldset",
      "title": "AC Infinity",
      "items": [
        "acinfinity.email",
        { "key": "acinfinity.password", "type": "password" },
        "acinfinity.controllerId",
        "acinfinity.port"
      ]
    },
    {
      "type": "fieldset",
      "title": "Cooldown",
      "items": ["cooldown.temperatureF", "cooldown.fanSpeed", "cooldown.checkIntervalMinutes", "scheduledOffTime"]
    },
    {
      "type": "fieldset",
      "title": "HUUM heater (optional)",
      "expandable": true,
      "description": "If configured, End Sauna stops the HUUM heater before starting the fan cooldown.",
      "items": ["huum.email", { "key": "huum.password", "type": "password" }]
    },
    {
      "type": "fieldset",
      "title": "Advanced",
      "expandable": true,
      "items": ["endSaunaName", "fanName", "debug"]
    }
  ]
}
